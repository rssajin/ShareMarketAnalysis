<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Antigravity | Indian Share Market & Mutual Fund Analysis</title>
  <meta name="description" content="Production-quality investment analysis and portfolio compliance system for Indian equities and mutual funds based on 100-point scoring framework and custom rules.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="app-container">
    <!-- Sidebar Navigation -->
    <aside class="sidebar">
      <div class="brand-header">
        <div class="brand-icon">📈</div>
        <div style="flex: 1;">
          <div class="brand-title">Antigravity</div>
          <span class="brand-badge">Market Intelligence</span>
        </div>
        <button class="sidebar-close-btn" id="sidebarCloseBtn" aria-label="Close Navigation" title="Close Menu">✕</button>
      </div>

      <ul class="nav-links">
        <li class="nav-item active" data-view="dashboard">
          <span class="icon">📊</span>
          <span class="nav-text">Dashboard</span>
        </li>
        <li class="nav-item" data-view="stocks">
          <span class="icon">🔍</span>
          <span class="nav-text">Stock Analysis</span>
        </li>
        <li class="nav-item" data-view="screener">
          <span class="icon">🏆</span>
          <span class="nav-text">Quality Tiers (A/B/C)</span>
        </li>
        <li class="nav-item" data-view="watchlist">
          <span class="icon">⭐</span>
          <span class="nav-text">Watchlist <span class="nav-watchlist-badge" id="navWatchlistBadge" style="display:none;">0</span></span>
        </li>
        <li class="nav-item" data-view="opportunities">
          <span class="icon">🎯</span>
          <span class="nav-text">Today's Stock Opportunities</span>
        </li>
        <li class="nav-item" data-view="mutual-funds">
          <span class="icon">📈</span>
          <span class="nav-text">Mutual Funds</span>
        </li>
        <li class="nav-item" data-view="portfolio">
          <span class="icon">💼</span>
          <span class="nav-text">Portfolio Manager</span>
        </li>
        <li class="nav-item" data-view="alerts">
          <span class="icon">🔔</span>
          <span class="nav-text">Alerts & Drift</span>
        </li>
        <li class="nav-item" data-view="audit">
          <span class="icon">📋</span>
          <span class="nav-text">Audit & Strategy</span>
        </li>
        <li class="nav-item" data-view="index-scanner">
          <span class="icon">📡</span>
          <span class="nav-text">Index Stock Scanner</span>
        </li>
        <li class="nav-item" data-view="chat">
          <span class="icon">💬</span>
          <span class="nav-text">AI Market Chat</span>
        </li>
        <li class="nav-item" data-view="settings">
          <span class="icon">⚙️</span>
          <span class="nav-text">Rule Settings</span>
        </li>
      </ul>

      <div class="sidebar-footer">
        <div>Step 1: Website Live Feed</div>
        <div class="data-source-indicator">
          <span class="pulse-dot"></span>
          <span>NSE, BSE, Screener &amp; AMFI Connected</span>
        </div>
      </div>
    </aside>

    <!-- Main Wrapper -->
    <div class="main-wrapper">
      <!-- Topbar Header -->
      <header class="topbar">
        <div class="topbar-left">
          <button class="menu-toggle-btn" id="menuToggleBtn" aria-label="Toggle Navigation Menubar" title="Hide / Show Menubar">
            <span class="menu-icon">☰</span>
          </button>
          <h1 class="page-title" id="pageTitleHeading">Investment Dashboard</h1>
        </div>
        <div class="topbar-right">
          <!-- Format Switcher: Mobile & Web Toggle Button -->
          <button class="view-mode-toggle-btn" id="viewModeToggleBtn" title="Toggle between Mobile View and Web Format">
            <span class="view-mode-icon" id="viewModeIcon">📱</span>
            <span class="view-mode-text" id="viewModeText">Mobile View</span>
          </button>
          <button class="secondary-btn topbar-desktop-only" id="refreshDataBtn" title="Re-sync data from live web feeds">
            <span>🔄</span> Refresh
          </button>
          <button class="primary-btn topbar-desktop-only" id="openAddHoldingModalBtn">
            <span>➕</span> Add Holding
          </button>
          <button class="alert-bell-btn" id="topAlertBellBtn" title="View Active Alerts">
            <span>🔔</span>
            <span class="alert-badge-count" id="headerAlertCount">0</span>
          </button>
        </div>
      </header>

      <!-- Content Area -->
      <main class="content-area">

        <!-- 1. DASHBOARD VIEW -->
        <section id="view-dashboard" class="view-section active">
          <!-- Profit trigger notification banner if active -->
          <div id="dashboardProfitBanner" style="display: none;"></div>

          <!-- Top 4 Metrics Row -->
          <div class="grid-4">
            <div class="card metric-card">
              <div class="metric-label">Total Portfolio Value</div>
              <div class="metric-value" id="dashTotalValue">₹0</div>
              <div class="metric-sub" id="dashTotalPnlSub">--</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">Rule Compliance Score</div>
              <div class="metric-value" id="dashComplianceScore">--%</div>
              <div class="metric-sub positive">Evaluated vs Target Rules</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">Active Holdings</div>
              <div class="metric-value" id="dashHoldingsCount">0</div>
              <div class="metric-sub">Across 4 Target Asset Buckets</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">Critical Alerts</div>
              <div class="metric-value" id="dashAlertsCount">0</div>
              <div class="metric-sub warning" id="dashAlertsSub">All rules compliant</div>
            </div>
          </div>

          <!-- Asset Allocation Grid -->
          <div class="grid-2">
            <div class="card">
              <h3 style="margin-bottom: 16px; font-size: 1.1rem; color: #fff;">Equity & ETF Allocation (Target: 40/30/20/10)</h3>
              <div style="height: 260px; position: relative;">
                <canvas id="dashAllocationChart"></canvas>
              </div>
              <div id="allocationBreakdownList" style="margin-top: 16px; display: flex; flex-direction: column; gap: 8px;"></div>
            </div>

            <div class="card">
              <h3 style="margin-bottom: 16px; font-size: 1.1rem; color: #fff;">Portfolio Rule Compliance Status</h3>
              <div id="dashRuleStatusList" style="display: flex; flex-direction: column; gap: 12px;"></div>
            </div>
          </div>

          <!-- Top Candidates & Quick Recommendations -->
          <div class="grid-2">
            <div class="card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 1.1rem; color: #fff;">Top Stock Candidates (100-Point Score)</h3>
                <button class="secondary-btn" style="padding: 6px 12px; font-size: 0.78rem;" onclick="app.navigateTo('stocks')">View Screener</button>
              </div>
              <div id="dashTopStocksList" style="display: flex; flex-direction: column; gap: 10px;"></div>
            </div>

            <div class="card">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="font-size: 1.1rem; color: #fff;">4-Fund SIP Framework Status</h3>
                <button class="secondary-btn" style="padding: 6px 12px; font-size: 0.78rem;" onclick="app.navigateTo('mutual-funds')">Manage Funds</button>
              </div>
              <div id="dashMfOverview" style="display: flex; flex-direction: column; gap: 12px;"></div>
            </div>
          </div>
        </section>

        <!-- 2. STOCK ANALYSIS VIEW -->
        <section id="view-stocks" class="view-section">
          <!-- Search Bar with Live Suggestions -->
          <div class="search-container">
            <span class="search-icon">🔍</span>
            <input type="text" id="stockSearchInput" class="search-input" placeholder="Search Indian stocks (e.g. TCS, INFY, RELIANCE, POLYCAB, KAYNES, HDFCBANK)..." autocomplete="off">
            <div id="stockSearchDropdown" class="search-dropdown"></div>
          </div>

          <!-- Active Stock Analysis Result Container -->
          <div id="stockAnalysisResult">
            <div class="card" style="text-align: center; padding: 40px 20px;">
              <div style="font-size: 3rem; margin-bottom: 12px;">🔍</div>
              <h3>Search Any Indian Stock</h3>
              <p style="color: var(--text-secondary); max-width: 500px; margin: 8px auto 0;">
                Live data fetched from Screener.in and Yahoo Finance. Calculates the exact 100-point score, Priority 10 checks, AI disruption risk, and valuation attractiveness.
              </p>
            </div>
          </div>
        </section>

        <!-- NEW: QUALITY TIERS SCREENER VIEW (Nifty 50 / 200 / 500 / BSE 100) -->
        <section id="view-screener" class="view-section">
          <!-- Screener Hero & Summary Metrics -->
          <div class="grid-4" id="screenerSummaryGrid">
            <div class="card metric-card">
              <div class="metric-label">🌟 Category A (Score 90+)</div>
              <div class="metric-value" id="screenerCatACount" style="color: var(--accent-amber);">0</div>
              <div class="metric-sub positive">Elite compounders (Top hurdle)</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">🥈 Category B (Score 85–90)</div>
              <div class="metric-value" id="screenerCatBCount" style="color: var(--accent-blue);">0</div>
              <div class="metric-sub positive">High-conviction candidates</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">🥉 Category C (Score 80–85)</div>
              <div class="metric-value" id="screenerCatCCount" style="color: var(--accent-emerald);">0</div>
              <div class="metric-sub">Solid hurdle passers</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">Total Stocks Screened</div>
              <div class="metric-value" id="screenerTotalCount">0</div>
              <div class="metric-sub">Nifty 50, 200, 500 & BSE 100</div>
            </div>
          </div>

          <!-- Interactive Filter Controls -->
          <div class="card" style="margin-bottom: 24px; padding: 20px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
              <!-- Market Cap Filter Bar -->
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                  <span style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Market Cap:</span>
                  <div class="filter-pill-group" id="screenerCapPills">
                    <button class="filter-pill active" data-cap="ALL">All Caps</button>
                    <button class="filter-pill" data-cap="LARGE_CAP">Large Cap (Nifty 50 / BSE 100)</button>
                    <button class="filter-pill" data-cap="MID_CAP">Mid Cap (Nifty 200)</button>
                    <button class="filter-pill" data-cap="SMALL_CAP">Small Cap (Nifty 500)</button>
                  </div>
                </div>

                <button class="secondary-btn" id="refreshScreenerBtn" style="padding: 6px 14px; font-size: 0.8rem;">
                  <span>🔄</span> Re-Score Universe
                </button>
              </div>

              <!-- Quality Tier Filter Bar -->
              <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <span style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Quality Tier:</span>
                <div class="filter-pill-group" id="screenerTierPills">
                  <button class="filter-pill active" data-tier="ALL">All Tiers</button>
                  <button class="filter-pill tier-a" data-tier="CATEGORY_A">🌟 Category A (90+)</button>
                  <button class="filter-pill tier-b" data-tier="CATEGORY_B">🥈 Category B (85–90)</button>
                  <button class="filter-pill tier-c" data-tier="CATEGORY_C">🥉 Category C (80–85)</button>
                </div>
              </div>

              <!-- Index & Search Bar -->
              <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary);">Index Filter:</span>
                  <select id="screenerIndexSelect" class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.82rem;">
                    <option value="ALL">All Indices</option>
                    <option value="NIFTY50">Nifty 50</option>
                    <option value="BSE100">BSE 100</option>
                    <option value="NIFTY200">Nifty 200</option>
                    <option value="NIFTY500">Nifty 500</option>
                  </select>
                </div>

                <div style="flex-grow: 1; min-width: 220px; position: relative;">
                  <input type="text" id="screenerSearchInput" class="form-input" placeholder="Filter by company name or symbol..." style="padding: 6px 12px; font-size: 0.85rem;">
                </div>
              </div>
            </div>
          </div>

          <!-- Screener Stocks Table & Cards View -->
          <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <div>
                <h3 style="font-size: 1.15rem; color: #fff;">Screened Stocks (<span id="screenerVisibleCount">0</span> Candidates Found)</h3>
                <p style="font-size: 0.8rem; color: var(--text-secondary);">Categorized using the 100-point scoring engine (Quality, Growth, Profitability, Financial Health, Cash Flow, Valuation, Moat).</p>
              </div>
            </div>

            <div class="table-wrapper">
              <table class="custom-table" id="screenerTable">
                <thead>
                  <tr>
                    <th>Symbol / Company</th>
                    <th>Quality Tier</th>
                    <th>Score</th>
                    <th>Cap & Index</th>
                    <th>Price</th>
                    <th>ROCE</th>
                    <th>ROE</th>
                    <th>5Y Sales CAGR</th>
                    <th>Debt / Eq</th>
                    <th>P/E</th>
                    <th>AI Disruption</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="screenerTableBody"></tbody>
              </table>
            </div>
          </div>
        </section>

        <!-- 3. MUTUAL FUNDS VIEW -->
        <section id="view-mutual-funds" class="view-section">
          <!-- 4-Fund Framework Header -->
          <div class="card" style="margin-bottom: 24px; background: linear-gradient(135deg, rgba(99,102,241,0.1), rgba(6,182,212,0.1));">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <div>
                <h2 style="font-size: 1.25rem; color: #fff; margin-bottom: 6px;">4-Fund Disciplined SIP Framework</h2>
                <p style="color: var(--text-secondary); font-size: 0.88rem;">
                  Strategy: Max 4 schemes, 30/30/30/10 target category allocation, 15-year wealth compounding horizon.
                </p>
              </div>
              <button class="primary-btn" id="openAddMfModalBtn">
                <span>➕</span> Add Fund Scheme
              </button>
            </div>
          </div>

          <!-- 4 Selected Funds List -->
          <div class="card" style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
              <h3 style="font-size: 1.1rem; color: #fff;">Selected SIP Portfolio Schemes (Max 4)</h3>
              <span id="fourFundRuleBadge" class="badge pass">Rule Satisfied (4/4 Funds)</span>
            </div>
            <div class="table-wrapper">
              <table class="custom-table" id="mfPortfolioTable">
                <thead>
                  <tr>
                    <th>Scheme Name</th>
                    <th>Category</th>
                    <th>Monthly SIP</th>
                    <th>Current NAV</th>
                    <th>Expense Ratio</th>
                    <th>5Y Return</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="mfPortfolioTableBody"></tbody>
              </table>
            </div>
          </div>

          <!-- 15-Year Horizon & Projection -->
          <div class="grid-2">
            <div class="card">
              <h3 style="margin-bottom: 14px; font-size: 1.1rem; color: #fff;">15-Year Horizon SIP Projection</h3>
              <div id="mfSipProjectionsDetails" style="display: flex; flex-direction: column; gap: 10px;"></div>
              <div style="margin-top: 16px; padding: 14px; background: rgba(255,255,255,0.02); border-radius: var(--radius-sm); border-left: 3px solid var(--accent-cyan);">
                <div style="font-size: 0.82rem; font-weight: 600; color: #fff; margin-bottom: 4px;">Post-SIP Tax Disclaimer</div>
                <div style="font-size: 0.78rem; color: var(--text-secondary); line-height: 1.5;" id="mfTaxGuidanceText"></div>
              </div>
            </div>

            <div class="card">
              <h3 style="margin-bottom: 14px; font-size: 1.1rem; color: #fff;">Portfolio Overlap Matrix</h3>
              <p style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 12px;">
                Ensures selected funds do not hold duplicate stock exposure.
              </p>
              <div id="mfOverlapContainer" style="display: flex; flex-direction: column; gap: 10px;"></div>
            </div>
          </div>

          <!-- Live AMFI Fund Search Section -->
          <div class="card" style="margin-top: 24px;">
            <h3 style="font-size: 1.1rem; color: #fff; margin-bottom: 14px;">Explore & Search All Indian Mutual Funds (AMFI Public Registry)</h3>
            <div class="search-container" style="margin-bottom: 12px;">
              <span class="search-icon">🔍</span>
              <input type="text" id="mfSearchInput" class="search-input" placeholder="Search by scheme name or fund house (e.g. Parag Parikh, UTI Nifty, Motilal, ICICI)...">
              <div id="mfSearchDropdown" class="search-dropdown"></div>
            </div>
            <div id="mfSchemeDetailsContainer"></div>
          </div>
        </section>

        <!-- 4. PORTFOLIO MANAGER VIEW -->
        <section id="view-portfolio" class="view-section">
          <!-- Rebalancing & Sell Trigger Banner -->
          <div id="portfolioSellAlertBanner"></div>

          <!-- Holdings Table Card -->
          <div class="card" style="margin-bottom: 24px;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px;">
              <div>
                <h3 style="font-size: 1.15rem; color: #fff;">Portfolio Holdings & Asset Buckets</h3>
                <p style="font-size: 0.82rem; color: var(--text-secondary);">Real-time valuation based on live market prices.</p>
              </div>
              <button class="primary-btn" onclick="app.openAddHoldingModal()">
                <span>➕</span> Add Holding
              </button>
            </div>

            <div class="table-wrapper">
              <table class="custom-table" id="holdingsTable">
                <thead>
                  <tr>
                    <th>Symbol / Name</th>
                    <th>Bucket</th>
                    <th>Qty</th>
                    <th>Avg Cost</th>
                    <th>Live Price</th>
                    <th>Current Value</th>
                    <th>P&L (%)</th>
                    <th>Allocation</th>
                    <th>Rule Review</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody id="holdingsTableBody"></tbody>
              </table>
            </div>
          </div>

          <!-- Rebalancing Suggestions Card -->
          <div class="card">
            <h3 style="font-size: 1.1rem; color: #fff; margin-bottom: 14px;">Rebalancing Guidance (Rule Compliance)</h3>
            <div id="portfolioRebalanceList" style="display: flex; flex-direction: column; gap: 12px;"></div>
          </div>
        </section>

        <!-- 5. ALERTS & DRIFT VIEW -->
        <section id="view-alerts" class="view-section">
          <div class="card" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-size: 1.1rem; color: #fff;">Active Alerts & Drift Warnings</h3>
              <p style="font-size: 0.82rem; color: var(--text-secondary);">Monitors portfolio allocation, concentration risk, and stock quality events.</p>
            </div>
            <button class="secondary-btn" id="refreshAlertsBtn"><span>🔄</span> Refresh Alerts</button>
          </div>

          <div id="alertsListContainer" style="display: flex; flex-direction: column; gap: 14px;"></div>
        </section>

        <!-- 6. AUDIT TRAIL & STRATEGY VIEW -->
        <section id="view-audit" class="view-section">
          <div class="card" style="margin-bottom: 24px;">
            <h3 style="font-size: 1.1rem; color: #fff; margin-bottom: 12px;">Audit Trail & Calculation Evidence (Rule 12)</h3>
            <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 16px;">
              Every recommendation and score preserves an audit record of the raw input snapshot, data source website, and calculated output.
            </p>
            <div class="table-wrapper">
              <table class="custom-table">
                <thead>
                  <tr>
                    <th>Timestamp</th>
                    <th>Operation</th>
                    <th>Target</th>
                    <th>Source Provider</th>
                    <th>Score / Status</th>
                    <th>Snapshot Payload</th>
                  </tr>
                </thead>
                <tbody id="auditTableBody"></tbody>
              </table>
            </div>
          </div>

          <div class="card">
            <h3 style="font-size: 1.1rem; color: #fff; margin-bottom: 12px;">Investment Strategy Source of Truth</h3>
            <ul style="color: var(--text-secondary); font-size: 0.88rem; line-height: 1.8; margin-left: 20px;">
              <li><strong>Equity Allocation:</strong> 40% Large-cap, 30% Mid-cap, 20% Small-cap, 10% Gold/Silver ETF.</li>
              <li><strong>Large-Cap Rule:</strong> Long-term holding (never auto-sold solely based on percentage return).</li>
              <li><strong>Mid/Small-Cap Profit Rule:</strong> At 10–15% return, review to lock gains and reduce risk.</li>
              <li><strong>Mutual Funds:</strong> Maximum 4 schemes; 30% Nifty Index, 30% Multi-cap, 30% Mid & Small-cap, 10% Debt/Money Market.</li>
              <li><strong>100-Point Scoring:</strong> Business Quality (20), Growth (20), Profitability (15), Financial Strength (15), Cash Flow (10), Valuation (10), Management (5), Moat (5).</li>
              <li><strong>Decision Support:</strong> No automatic trade execution; all suggestions require manual user confirmation.</li>
            </ul>
          </div>
        </section>

        <!-- 7. SETTINGS VIEW -->
        <section id="view-settings" class="view-section">
          <div class="card" style="max-width: 680px;">
            <h3 style="font-size: 1.15rem; color: #fff; margin-bottom: 18px;">Configurable Strategy Thresholds</h3>
            <form id="settingsForm">
              <div class="form-group">
                <label class="form-label">Allocation Tolerance Band (± %)</label>
                <input type="number" id="settingToleranceBand" class="form-input" min="1" max="15" step="0.5">
              </div>
              <div class="grid-2">
                <div class="form-group">
                  <label class="form-label">Mid/Small Cap Sell Trigger Min (%)</label>
                  <input type="number" id="settingSellTriggerMin" class="form-input" min="5" max="50">
                </div>
                <div class="form-group">
                  <label class="form-label">Mid/Small Cap Sell Trigger Max (%)</label>
                  <input type="number" id="settingSellTriggerMax" class="form-input" min="5" max="50">
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Minimum Stock Score Candidate Threshold (out of 100)</label>
                <input type="number" id="settingMinScore" class="form-input" min="50" max="95">
              </div>
              <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button type="submit" class="primary-btn">Save Configurations</button>
                <button type="button" class="secondary-btn" id="resetConfigBtn">Reset Defaults</button>
              </div>
            </form>
          </div>
        </section>

        <!-- 8. WATCHLIST VIEW -->
        <section id="view-watchlist" class="view-section">
          <!-- Summary Bar -->
          <div class="grid-4" style="margin-bottom: 24px;">
            <div class="card metric-card">
              <div class="metric-label">⭐ Total Watched</div>
