              <div class="metric-label">⚠️ Sell / Reduce</div>
              <div class="metric-value" id="oppSummarySells" style="color: var(--accent-rose);">0</div>
              <div class="metric-sub warning">Profit rule / stretch</div>
            </div>
            <div class="card metric-card">
              <div class="metric-label">❓ Incomplete Data</div>
              <div class="metric-value" id="oppSummaryIncomplete" style="color: var(--text-muted);">0</div>
              <div class="metric-sub">Missing ratios/stale</div>
            </div>
          </div>

          <!-- Interactive Filters & Cheapest-First Sorting Card -->
          <div class="card" style="margin-bottom: 24px; padding: 20px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">

              <!-- Row 1: Market-Cap Category Pills -->
              <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
                <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                  <span style="font-size: 0.82rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Market Cap:</span>
                  <div class="filter-pill-group" id="oppsCapPills">
                    <button class="filter-pill active" data-oppcap="ALL">All Categories</button>
                    <button class="filter-pill" data-oppcap="LARGE_CAP">Large Cap (&ge;₹50k Cr)</button>
                    <button class="filter-pill" data-oppcap="MID_CAP">Mid Cap (₹15k–50k Cr)</button>
                    <button class="filter-pill" data-oppcap="SMALL_CAP">Small Cap (₹1k–15k Cr)</button>
                    <button class="filter-pill" data-oppcap="MICRO_CAP">Micro Cap (&lt;₹1k Cr)</button>
                    <button class="filter-pill" data-oppcap="UNCLASSIFIED">Unclassified</button>
                  </div>
                </div>
                <div style="font-size: 0.74rem; color: var(--text-muted); background: rgba(255,255,255,0.03); padding: 4px 10px; border-radius: var(--radius-sm); border: 1px dashed var(--border-subtle);">
                  ℹ️ Micro Cap (&lt;₹1,000 Cr) is an application-defined risk segment, not an official SEBI mutual fund category.
                </div>
              </div>

              <!-- Row 2: Secondary Dropdown Filters -->
              <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Signal:</span>
                  <select id="oppsSignalSelect" class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.82rem;">
                    <option value="ALL">All Signals</option>
                    <option value="BUY">🎯 Buy Candidates Only</option>
                    <option value="HOLD_WATCH">⏳ Hold / Watch Only</option>
                    <option value="SELL_REDUCE">⚠️ Sell / Reduce Only</option>
                  </select>
                </div>

                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Min Score:</span>
                  <select id="oppsScoreSelect" class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.82rem;">
                    <option value="0">All Scores</option>
                    <option value="70">Score &ge; 70 (Good)</option>
                    <option value="80" selected>Score &ge; 80 (Candidates)</option>
                    <option value="85">Score &ge; 85 (Cat B+)</option>
                    <option value="90">Score &ge; 90 (Cat A Only)</option>
                  </select>
                </div>

                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Valuation:</span>
                  <select id="oppsValuationSelect" class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.82rem;">
                    <option value="ALL">All Valuations</option>
                    <option value="DEEPLY_UNDERVALUED">💎 Deep Value (&ge;20% MoS)</option>
                    <option value="UNDERVALUED">🟢 Undervalued (&ge;5% MoS)</option>
                    <option value="FAIR_VALUE">⚖️ Near Industry P/E Reference (&plusmn;10%)</option>
                    <option value="OVERVALUED">⏳ Overvalued</option>
                  </select>
                </div>

                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Risk:</span>
                  <select id="oppsRiskSelect" class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.82rem;">
                    <option value="ALL">All Risk Levels</option>
                    <option value="LOW">🟢 Low Risk (Large Cap, D/E&lt;0.3)</option>
                    <option value="MODERATE">🟡 Moderate Risk</option>
                    <option value="HIGH">🔴 High Risk / Micro Cap</option>
                  </select>
                </div>

                <div style="display: flex; align-items: center; gap: 6px;">
                  <span style="font-size: 0.8rem; font-weight: 600; color: var(--text-secondary); text-transform: uppercase;">Sector:</span>
                  <select id="oppsSectorSelect" class="form-select" style="width: auto; padding: 6px 12px; font-size: 0.82rem;">
                    <option value="ALL">All Sectors</option>
                    <option value="Information Technology">Information Technology</option>
                    <option value="Financial Services">Financial Services</option>
                    <option value="Consumer Goods">Consumer Goods</option>
                    <option value="Healthcare">Healthcare / Pharma</option>
                    <option value="Energy">Energy</option>
                    <option value="Industrials">Industrials / Infra</option>
                    <option value="Automobile">Automobile</option>
                    <option value="Chemicals">Chemicals</option>
                    <option value="Metals">Metals &amp; Mining</option>
                    <option value="FMCG">FMCG</option>
                  </select>
                </div>
              </div>

              <!-- Row 3: Cheapest-First Sorting, Search & Reset -->
              <div style="display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span style="font-size: 0.82rem; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase;">Sort Order:</span>
                  <select id="oppsSortSelect" class="form-select" style="width: auto; min-width: 280px; padding: 6px 14px; font-size: 0.85rem; font-weight: 600; color: #fff; background: rgba(15, 23, 42, 0.95); border-color: rgba(59, 130, 246, 0.4);">
                    <option value="cheapest_fair_value" selected>💎 Lowest vs Industry P/E Reference</option>
                    <option value="highest_margin_of_safety">📈 Highest Discount to Industry P/E Reference</option>
                    <option value="lowest_pe">📉 Lowest P/E Ratio</option>
                    <option value="lowest_pb">📊 Lowest P/B Ratio</option>
                    <option value="highest_score">🏆 Highest Quality Score (100-Pt)</option>
                    <option value="highest_earnings_growth">🚀 Highest Earnings Growth (5Y Profit CAGR)</option>
                    <option value="highest_roce">💰 Highest ROCE</option>
                    <option value="lowest_debt_equity">🛡️ Lowest Debt-to-Equity</option>
                    <option value="lowest_price">🏷️ Lowest Current Market Price</option>
                    <option value="lowest_risk">🟢 Lowest Risk Among Eligible</option>
                  </select>
                </div>

                <div style="flex-grow: 1; min-width: 220px;">
                  <input type="text" id="oppsSearchInput" class="form-input" placeholder="Search opportunity by name or symbol..." style="padding: 6px 12px; font-size: 0.85rem;">
                </div>

                <button class="secondary-btn" id="oppsResetFiltersBtn" style="padding: 6px 14px; font-size: 0.82rem;">
                  🔄 Reset Filters
                </button>
              </div>

            </div>
          </div>

          <!-- Initial Placeholder Card (Shown before user generates) -->
          <div id="oppsInitialPlaceholder" class="card" style="text-align: center; padding: 50px 20px; background: rgba(255,255,255,0.01); border: 1px dashed var(--border-subtle); margin-bottom: 24px;">
            <div style="font-size: 3.2rem; margin-bottom: 12px;">🎯</div>
            <h3 style="color: #fff; font-size: 1.25rem;">Ready to Scan Watchlist Opportunities</h3>
            <p style="color: var(--text-secondary); max-width: 540px; margin: 8px auto 20px; line-height: 1.6;">
              Click <strong>Generate Today's Opportunities</strong> above to screen your saved Watchlist stocks against the existing 100-point scoring framework, compare supported P/E ratios with industry P/E references, and categorize stocks into <strong>Buy Candidates</strong>, <strong>Hold/Watch</strong>, and <strong>Sell/Reduce</strong> review signals.
            </p>
            <button class="primary-btn" id="oppsStartAnalysisBtn" style="padding: 10px 24px; font-size: 0.9rem; font-weight: 700;">
              <span>🚀</span> Start Analysis Now
            </button>
          </div>

          <!-- Results Container (Shown after analysis) -->
          <div id="oppsResultsContainer" style="display: none;">

            <!-- SECTION 1: TODAY'S BUY CANDIDATES -->
            <div class="card" style="margin-bottom: 28px; border-left: 4px solid var(--accent-emerald);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 style="font-size: 1.2rem; color: #fff; margin: 0;">🎯 Today's Buy Candidates</h3>
                    <span id="oppsBuyCountBadge" class="badge pass" style="font-size: 0.76rem; font-weight: 700;">0 Candidates</span>
                  </div>
                  <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 4px;">
                    Stocks satisfying the 100-point quality framework (Score &ge; 80), sound balance sheet (D/E &le; 0.6), robust ROCE, and trading at attractive valuation or within optimal entry zone.
                  </p>
                </div>
              </div>

              <!-- Buy Candidates Mobile Cards -->
              <div class="opps-mobile-cards" id="oppsBuyMobileCards"></div>

              <!-- Buy Candidates Table -->
              <div class="table-wrapper" id="oppsBuyTableWrapper">
                <table class="custom-table" id="oppsBuyTable">
                  <thead>
                    <tr>
                      <th>Company / Symbol</th>
                      <th>Exchange / Cap</th>
                      <th>Sector</th>
                      <th>Quality Score</th>
                      <th>Valuation Status</th>
                      <th>Current Price</th>
                      <th>Industry P/E Reference</th>
                      <th>Relative Price Discount</th>
                      <th>P/E</th>
                      <th>ROCE</th>
                      <th>ROE</th>
                      <th>D/E</th>
                      <th>5Y Sales / Profit</th>
                      <th>Entry Range</th>
                      <th>Risk</th>
                      <th>Failed Checks</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="oppsBuyTableBody"></tbody>
                </table>
              </div>

              <!-- Buy Empty State -->
              <div id="oppsBuyEmptyState" style="display: none; text-align: center; padding: 36px 20px; color: var(--text-secondary);">
                <div style="font-size: 2rem; margin-bottom: 8px;">🔍</div>
                <div style="font-size: 0.95rem; font-weight: 600; color: #fff;">No stocks currently meet the selected buy criteria.</div>
                <div style="font-size: 0.8rem; color: var(--text-muted); margin-top: 4px;">Stocks in your watchlist may be high-quality but currently overvalued or awaiting pullback. See Hold / Watch candidates below.</div>
              </div>
            </div>

            <!-- SECTION 2: HOLD / WATCH CANDIDATES -->
            <div class="card" style="margin-bottom: 28px; border-left: 4px solid var(--accent-amber);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 style="font-size: 1.2rem; color: #fff; margin: 0;">⏳ Hold / Watch Candidates</h3>
                    <span id="oppsHoldCountBadge" class="badge warning" style="font-size: 0.76rem; font-weight: 700;">0 Candidates</span>
                  </div>
                  <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 4px;">
                    Quality businesses monitored on your radar. Currently trading above optimal buy zones (waiting for price pullback), or requiring further earnings confirmation.
                  </p>
                </div>
              </div>

              <!-- Hold Mobile Cards -->
              <div class="opps-mobile-cards" id="oppsHoldMobileCards"></div>

              <!-- Hold Table -->
              <div class="table-wrapper" id="oppsHoldTableWrapper">
                <table class="custom-table" id="oppsHoldTable">
                  <thead>
                    <tr>
                      <th>Company / Symbol</th>
                      <th>Cap Category</th>
                      <th>Current Price</th>
                      <th>Quality Score</th>
                      <th>Valuation Status</th>
                      <th>Relative Price Discount</th>
                      <th>Preferred Entry Range</th>
                      <th>Reason for Watchlist Classification</th>
                      <th>Failed Checks</th>
                      <th>Risk</th>
                      <th>Last Updated</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="oppsHoldTableBody"></tbody>
                </table>
              </div>

              <!-- Hold Empty State -->
              <div id="oppsHoldEmptyState" style="display: none; text-align: center; padding: 30px 20px; color: var(--text-secondary);">
                <div style="font-size: 0.9rem; color: var(--text-muted);">No hold/watch stocks found matching the current filters.</div>
              </div>
            </div>

            <!-- SECTION 3: SELL / REDUCE CANDIDATES -->
            <div class="card" style="margin-bottom: 28px; border-left: 4px solid var(--accent-rose);">
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; flex-wrap: wrap; gap: 10px;">
                <div>
                  <div style="display: flex; align-items: center; gap: 10px;">
                    <h3 style="font-size: 1.2rem; color: #fff; margin: 0;">⚠️ Sell / Reduce Candidates</h3>
                    <span id="oppsSellCountBadge" class="badge fail" style="font-size: 0.76rem; font-weight: 700;">0 Candidates</span>
                  </div>
                  <p style="font-size: 0.82rem; color: var(--text-secondary); margin-top: 4px;">
                    Stocks subject to risk reduction: Mid/Small-cap holdings triggering the 10–15% profit-booking rule, extreme valuation stretch, or significant fundamental deterioration.
                  </p>
                </div>
              </div>

              <!-- Sell Mobile Cards -->
              <div class="opps-mobile-cards" id="oppsSellMobileCards"></div>

              <!-- Sell Table -->
              <div class="table-wrapper" id="oppsSellTableWrapper">
                <table class="custom-table" id="oppsSellTable">
                  <thead>
                    <tr>
                      <th>Company / Symbol</th>
                      <th>Ownership Status</th>
                      <th>Current Price</th>
                      <th>Quality Score</th>
                      <th>Valuation Status</th>
                      <th>Sell / Reduce Signal</th>
                      <th>Signal Reason &amp; Deterioration Indicators</th>
                      <th>Failed Checks</th>
                      <th>Risk Level</th>
                      <th>Last Updated</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody id="oppsSellTableBody"></tbody>
                </table>
              </div>

              <!-- Sell Empty State -->
              <div id="oppsSellEmptyState" style="display: none; text-align: center; padding: 30px 20px; color: var(--text-secondary);">
                <div style="font-size: 0.9rem; color: var(--text-muted);">No stocks currently trigger sell or reduce signals under current criteria.</div>
              </div>
            </div>

          </div>
        </section>

      </main>
    </div>
  </div>

  <!-- Add Holding Modal -->
  <div class="modal-overlay" id="addHoldingModal">
    <div class="modal-card">
      <div class="modal-header">
        <h3 style="color: #fff; font-size: 1.15rem;">Add Holding to Portfolio</h3>
        <button class="close-btn" id="closeAddHoldingModal">&times;</button>
      </div>
      <form id="addHoldingForm">
        <div class="form-group">
          <label class="form-label">Symbol (NSE / BSE)</label>
          <input type="text" id="modalHoldingSymbol" class="form-input" placeholder="e.g. INFY, RELIANCE, GOLDBEES" required>
        </div>
        <div class="form-group">
          <label class="form-label">Asset Bucket</label>
          <select id="modalHoldingCategory" class="form-select">
            <option value="LARGE_CAP">Large-Cap Stock (Target 40%)</option>
            <option value="MID_CAP">Mid-Cap Stock (Target 30%)</option>
            <option value="SMALL_CAP">Small-Cap Stock (Target 20%)</option>
            <option value="ETF_GOLD_SILVER">Gold/Silver ETF (Target 10%)</option>
          </select>
        </div>
        <div class="grid-2">
          <div class="form-group">
            <label class="form-label">Quantity</label>
            <input type="number" id="modalHoldingQty" class="form-input" min="1" step="1" required>
          </div>
          <div class="form-group">
            <label class="form-label">Average Purchase Cost (₹)</label>
            <input type="number" id="modalHoldingCost" class="form-input" min="0.01" step="0.01" required>
          </div>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
          <button type="button" class="secondary-btn" id="cancelAddHoldingBtn">Cancel</button>
          <button type="submit" class="primary-btn">Save Holding</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Mutual Fund Scheme Modal -->
  <div class="modal-overlay" id="addMfModal">
    <div class="modal-card">
      <div class="modal-header">
        <h3 style="color: #fff; font-size: 1.15rem;">Add Scheme to 4-Fund SIP Portfolio</h3>
        <button class="close-btn" id="closeAddMfModal">&times;</button>
      </div>
      <form id="addMfForm">
        <div class="form-group">
          <label class="form-label">AMFI Scheme Code</label>
          <input type="text" id="modalMfSchemeCode" class="form-input" placeholder="e.g. 122639 (Parag Parikh Flexi Cap)" required>
          <small style="color: var(--text-muted); font-size: 0.75rem;">Tip: Search schemes in the Mutual Funds tab to get the official AMFI code.</small>
        </div>
        <div class="form-group">
          <label class="form-label">Monthly SIP Amount (₹)</label>
          <input type="number" id="modalMfSipAmount" class="form-input" min="500" step="500" value="10000" required>
        </div>
        <div class="form-group">
          <label class="form-label">SIP Start Date</label>
          <input type="date" id="modalMfStartDate" class="form-input" required>
        </div>
        <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
          <button type="button" class="secondary-btn" id="cancelAddMfBtn">Cancel</button>
          <button type="submit" class="primary-btn">Add Fund Scheme</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Import Watchlist CSV Modal -->
  <div class="modal-overlay" id="importCsvModal">
    <div class="modal-card" style="max-width: 620px;">
      <div class="modal-header">
        <h3 style="color: #fff; font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">
          <span>📥</span> Import Watchlist from CSV
        </h3>
        <button class="close-btn" id="closeImportCsvModal">&times;</button>
      </div>
      <div style="margin-bottom: 16px;">
        <p style="font-size: 0.84rem; color: var(--text-secondary); line-height: 1.5; margin-bottom: 8px;">
          Upload a <code>.csv</code> file or paste rows below. The required columns are:
          <strong style="color: var(--accent-emerald);">symbol,company_name,market_cap_type</strong>
        </p>
        <div style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-subtle); border-radius: var(--radius-sm); padding: 8px 12px; font-family: monospace; font-size: 0.78rem; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center;">
          <div>
            symbol,company_name,market_cap_type<br>
            LUPIN,Lupin,Large Cap<br>
            BAJAJ-AUTO,Bajaj Auto,Large Cap
          </div>
          <button type="button" class="secondary-btn" id="downloadSampleCsvBtn" style="padding: 4px 8px; font-size: 0.72rem; white-space: nowrap;">
            📄 Sample CSV
          </button>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" style="display: flex; justify-content: space-between; align-items: center;">
          <span>Upload CSV File</span>
          <span style="font-size: 0.75rem; color: var(--text-muted);">(.csv or .txt)</span>
        </label>
        <input type="file" id="csvFileInput" accept=".csv,text/csv,text/plain" class="form-input" style="padding: 8px;">
      </div>

      <div style="text-align: center; margin: 12px 0; color: var(--text-muted); font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em;">
        ── OR Paste CSV Text ──
      </div>

      <div class="form-group">
        <label class="form-label">CSV Text</label>
        <textarea id="csvTextInput" class="form-input" rows="6" style="font-family: monospace; font-size: 0.82rem; resize: vertical;" placeholder="symbol,company_name,market_cap_type&#10;LUPIN,Lupin,Large Cap&#10;BAJAJ-AUTO,Bajaj Auto,Large Cap"></textarea>
      </div>

      <!-- Preview / Feedback area -->
      <div id="csvImportPreview" style="display: none; padding: 10px 14px; border-radius: var(--radius-sm); margin-bottom: 16px; font-size: 0.82rem;"></div>

      <div style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 20px;">
        <button type="button" class="secondary-btn" id="cancelImportCsvBtn">Cancel</button>
        <button type="button" class="primary-btn" id="submitImportCsvBtn">
          <span>🚀</span> Import to Watchlist
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div class="toast-container" id="toastContainer"></div>

  <!-- Mobile Drawer Backdrop Overlay -->
  <div class="mobile-drawer-backdrop" id="mobileDrawerBackdrop"></div>

  <!-- Mobile Bottom Navigation Bar (Android Optimized) -->
  <nav class="mobile-bottom-nav" id="mobileBottomNav" aria-label="Mobile Navigation">
    <button class="mobile-bottom-nav-item" data-view="stocks" title="Stock Analysis">
      <span class="bnav-icon">🔍</span>
      <span class="bnav-label">Analysis</span>
    </button>
    <button class="mobile-bottom-nav-item" data-view="watchlist" title="My Watchlist">
      <span class="bnav-icon">⭐</span>
      <span class="bnav-label">Watchlist</span>
      <span class="bnav-badge" id="bnavWatchlistBadge" style="display:none;">0</span>
    </button>
    <button class="mobile-bottom-nav-item" data-view="screener" title="Quality Tiers">
      <span class="bnav-icon">🏆</span>
      <span class="bnav-label">Screener</span>
    </button>
    <button class="mobile-bottom-nav-item active" data-view="dashboard" title="Dashboard">
      <span class="bnav-icon">📊</span>
      <span class="bnav-label">Dashboard</span>
    </button>
    <button class="mobile-bottom-nav-item" id="mobileMoreMenuBtn" title="More Menus">
      <span class="bnav-icon">☰</span>
      <span class="bnav-label">Menu</span>
    </button>
  </nav>

  <!-- Floating Chat FAB -->
  <button class="fab-chat" id="fabChatBtn" title="Open AI Market Chat">
    <span class="fab-icon">💬</span>
    <span class="fab-label">AI Chat</span>
  </button>

  <script src="app.js?v=20261021-opportunities-rule-rebuild"></script>
</body>
</html>

